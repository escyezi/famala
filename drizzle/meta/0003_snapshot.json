          "name": "code_length_check",
          "value": "length(\"redemption_codes\".\"code\") BETWEEN 1 AND 100"
        },
        "remark_length_check": {
          "name": "remark_length_check",
          "value": "\"redemption_codes\".\"remark\" IS NULL OR length(\"redemption_codes\".\"remark\") <= 500"
        },
        "code_status_check": {
          "name": "code_status_check",
          "value": "\"redemption_codes\".\"status\" IN ('unclaimed', 'claimed', 'redeemed')"
        },
        "claim_state_check": {
          "name": "claim_state_check",
          "value": "(\"redemption_codes\".\"status\" != 'unclaimed' OR \"redemption_codes\".\"claimed_at\" IS NULL) AND (\"redemption_codes\".\"status\" != 'claimed' OR \"redemption_codes\".\"claimed_at\" IS NOT NULL) AND (\"redemption_codes\".\"claimed_at\" IS NOT NULL OR \"redemption_codes\".\"remark\" IS NULL)"
        },
        "redeemed_state_check": {
          "name": "redeemed_state_check",
          "value": "(\"redemption_codes\".\"status\" = 'redeemed' AND \"redemption_codes\".\"redeemed_marked_at\" IS NOT NULL) OR (\"redemption_codes\".\"status\" != 'redeemed' AND \"redemption_codes\".\"redeemed_marked_at\" IS NULL)"

{
  "name": "famala",
  "license": "MIT",
  "description": "Key-based redemption code distribution on Cloudflare Workers and D1",
  "cloudflare": {
    "label": "Famala",
    "products": [
      "Workers",
      "D1"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true,
    "bindings": {
      "DB": {
        "description": "D1 database for application data. Cloudflare creates and binds this database during setup."
      },
      "ENVIRONMENT": {
        "description": "Set to `production` for deployment. The `.env.example` development value is only for local testing."
      },
      "TURNSTILE_SITE_KEY": {
        "description": "Site key of your production Managed Turnstile widget. Replace the public test key."
      },
      "TURNSTILE_HOSTNAMES": {
        "description": "Allowed deployment hostnames, comma-separated, without protocol, port, or path. Also allow these hostnames in your Turnstile widget. Replace localhost values."
      },
      "TURNSTILE_SECRET_KEY": {
        "description": "Secret key of the same production Turnstile widget. Replace the public test secret; never commit your real secret."
      }
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "hono": "4.11.1",
    "i18next": "^26.4.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "5.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "wrangler": "^4.135.0"
  },
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "npm run lint && npm test && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "dev": "vite",
    "lint": "prettier --check . && tsc -b && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:components": "vitest run --project components",
    "test:unit": "vitest run --project unit",
    "preview": "npm run build && vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "predev": "WRANGLER_HIDE_BANNER=true npm run db:migrate",
    "db:counters:check": "node scripts/counters.mjs check",
    "db:counters:rebuild": "node scripts/counters.mjs rebuild",
    "deploy:maintenance": "wrangler deploy src/worker/maintenance.ts --config wrangler.jsonc --assets dist/client",
    "db:sessions:cleanup": "node scripts/sessions.ts"
  },
  "type": "module"
}

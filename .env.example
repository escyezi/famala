# Ready-to-use local configuration with official public Turnstile test keys.
# Copy to .env for development. Never commit .env.
# For deployment, set public variables in wrangler.jsonc and store the real secret
# through Cloudflare or `wrangler secret put TURNSTILE_SECRET_KEY`.
ENVIRONMENT="development"
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"
